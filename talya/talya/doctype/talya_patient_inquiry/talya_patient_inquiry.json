 "module": "Talya",
 "engine": "InnoDB",
 "autoname": "hash",
 "field_order": [
  "patient_name",
  "mobile_number",
  "normalized_phone",
  "healthcare_practitioner",
  "requested_service",
  "preferred_date",
  "preferred_time",
  "source",
  "status",
  "notes",
  "website_booking",
  "linked_patient",
  "linked_patient_appointment",
  "whatsapp_consent",
  "consent_recorded_at",
  "opt_out",
  "import_key",
  "wa_profile",
  "consent_phone",
  "recipient_changed_at",
  "patient_verified_at"
 ],
 "fields": [
